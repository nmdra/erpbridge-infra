{
 "apiVersion": "erpbridge.io/v1",
 "kind": "MCPTool",
 "metadata": {
  "name": "remove_assignment",
  "version": "1.0.0",
  "module": "erpnext"
 },
 "spec": {
  "description": {
   "short": "Remove the selected assignee using native Frappe permission checks.",
   "whenToUse": [
    "Remove the selected assignee using native Frappe permission checks."
   ],
   "whenNotToUse": [
    "Do not use user or role administration, and do not bypass native assignment permissions."
   ],
   "examples": [
    "remove_assignment through the native assignment action."
   ]
  },
  "annotations": {
   "readOnlyHint": false,
   "destructiveHint": true,
   "idempotentHint": false,
   "openWorldHint": true
  },
  "inputSchema": {
   "type": "object",
   "required": [
    "doctype",
    "name",
    "assign_to"
   ],
   "properties": {
    "doctype": {
     "type": "string",
     "enum": [
      "Asset",
      "Asset Category",
      "Asset Depreciation Schedule",
      "Asset Maintenance",
      "Asset Movement",
      "Asset Repair",
      "Company",
      "Customer",
      "Item",
      "Item Group",
      "Journal Entry",
      "Location",
      "Payment Entry",
      "Purchase Invoice",
      "Purchase Order",
      "Sales Invoice",
      "Sales Order",
      "Supplier",
      "UOM"
     ]
    },
    "name": {
     "type": "string"
    },
    "assign_to": {
     "type": "string"
    }
   },
   "additionalProperties": false
  },
  "outputSchema": {
   "type": "object",
   "required": [
    "message"
   ],
   "properties": {
    "message": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "owner",
       "name"
      ],
      "properties": {
       "owner": {
        "type": "string"
       },
       "name": {
        "type": "string"
       }
      },
      "additionalProperties": true
     }
    }
   },
   "additionalProperties": true
  },
  "execution": {
   "type": "http",
   "method": "POST",
   "endpoint": "https://erpnext.nimendra.online/api/method/frappe.desk.form.assign_to.remove",
   "mapping": {
    "doctype": "doctype",
    "name": "name",
    "assign_to": "assign_to"
   },
   "parameterLocations": {
    "doctype": "body",
    "name": "body",
    "assign_to": "body"
   }
  },
  "cache": {
   "enabled": false,
   "ttlSeconds": 0,
   "isReadOnly": false,
   "flushOn": []
  },
  "security": {
   "authType": "api-key",
   "authHeader": "Authorization",
   "credentialRef": "ERP_PRIMARY_KEY",
   "credentialSource": "env"
  }
 }
}

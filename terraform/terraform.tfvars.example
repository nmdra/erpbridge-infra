# Copy to terraform.tfvars or export TF_VAR_* values in the shell.
# terraform.tfvars is ignored by Git.

subscription_id    = "00000000-0000-0000-0000-000000000000"
tenant_id          = "00000000-0000-0000-0000-000000000000"
deployment_location = "centralindia"

# Use immutable image@sha256:<64 lowercase hex> references.
erpbridge_image = "ghcr.io/nmdra/erpbridge-server@sha256:511539c80c028427000cb9471f3eda8c2cd3a145095461d788f79f3a2609d6ee"
mockerp_image   = "ghcr.io/nmdra/mockerp@sha256:67a25057cbb2a3c4422be8e97b8a3096219645730bf42ae5e9a0a53c86c6c345"

# Existing Cloudflare zone. Records remain DNS-only for Azure certificate validation.
# Set to null to disable custom domains.
custom_domains = {
  zone_id   = "00000000000000000000000000000000"
  erpbridge = "erpbridge.example.com"
  mockerp   = "mockerp.example.com"
}

# Public IPv4 CIDR for the local Postman client.
mockerp_allowed_cidrs       = ["203.0.113.10/32"]
mockerp_allow_all_ingress   = false

# Same-environment Azure Container Apps source range used by this demo.
mockerp_aca_internal_cidrs = ["100.100.0.0/16"]

# Do not commit real values. Set these through TF_VAR_* instead.
# api_auth_token = ""
# mockerp_credentials = {
#   credentials = [{
#     api_key    = "example-key"
#     api_secret = "example-secret"
#     role       = "admin"
#     identity   = "example"
#   }]
# }

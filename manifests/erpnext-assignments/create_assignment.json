{
 "apiVersion": "erpbridge.io/v1",
 "kind": "MCPTool",
 "metadata": {
  "name": "create_assignment",
  "version": "1.0.0",
  "module": "erpnext"
 },
 "spec": {
  "description": {
   "short": "Create assignments for user login strings. Native permission checks apply. May auto-share the referenced document if permitted; notification delivery is not proven.",
   "whenToUse": [
    "Create assignments for user login strings. Native permission checks apply. May auto-share the referenced document if permitted; notification delivery is not proven."
   ],
   "whenNotToUse": [
    "Do not use user or role administration, and do not bypass native assignment permissions."
   ],
   "examples": [
    "create_assignment through the native assignment action."
   ]
  },
  "annotations": {
   "readOnlyHint": false,
   "destructiveHint": true,
   "idempotentHint": false,
   "openWorldHint": true
  },
  "inputSchema": {
   "type": "object",
   "required": [
    "doctype",
    "name",
    "assign_to"
   ],
   "properties": {
    "doctype": {
     "type": "string",
     "enum": [
      "Asset",
      "Asset Category",
      "Asset Depreciation Schedule",
      "Asset Maintenance",
      "Asset Movement",
      "Asset Repair",
      "Company",
      "Customer",
      "Item",
      "Item Group",
      "Journal Entry",
      "Location",
      "Payment Entry",
      "Purchase Invoice",
      "Purchase Order",
      "Sales Invoice",
      "Sales Order",
      "Supplier",
      "UOM"
     ]
    },
    "name": {
     "type": "string"
    },
    "assign_to": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "description": {
     "type": "string"
    },
    "priority": {
     "type": "string",
     "enum": [
      "Low",
      "Medium",
      "High"
     ]
    },
    "date": {
     "type": "string",
     "format": "date"
    }
   },
   "additionalProperties": false
  },
  "outputSchema": {
   "type": "object",
   "required": [
    "message"
   ],
   "properties": {
    "message": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "owner",
       "name"
      ],
      "properties": {
       "owner": {
        "type": "string"
       },
       "name": {
        "type": "string"
       }
      },
      "additionalProperties": true
     }
    }
   },
   "additionalProperties": true
  },
  "execution": {
   "type": "http",
   "method": "POST",
   "endpoint": "https://erpnext.nimendra.online/api/method/frappe.desk.form.assign_to.add",
   "mapping": {
    "doctype": "doctype",
    "name": "name",
    "assign_to": "assign_to",
    "description": "description",
    "priority": "priority",
    "date": "date"
   },
   "parameterLocations": {
    "doctype": "body",
    "name": "body",
    "assign_to": "body",
    "description": "body",
    "priority": "body",
    "date": "body"
   }
  },
  "cache": {
   "enabled": false,
   "ttlSeconds": 0,
   "isReadOnly": false,
   "flushOn": []
  },
  "security": {
   "authType": "api-key",
   "authHeader": "Authorization",
   "credentialRef": "ERP_PRIMARY_KEY",
   "credentialSource": "env"
  }
 }
}
